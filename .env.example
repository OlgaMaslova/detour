# Production API. For local work use .env.local (http://127.0.0.1:8090).
VITE_POCKETBASE_URL=https://api.takedetour.app

# Google Maps. With a key set, both maps (the city board and the place locator)
# are Google's; without one they fall back to Leaflet over OpenStreetMap, which
# needs no account and is what a fresh checkout gets. Restrict the key to
# takedetour.app by HTTP referrer; it ships in the bundle. The map ID carries the
# tape palette, and advanced markers will not draw without one.
# See docs/google-maps-setup.md.
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_MAP_ID=
